      <aliases enabled='yes' />
      <column caption='TCS Decoupling Improvement' datatype='real' name='[Calculation_0268326979305472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    IF [period] = &quot;Period B (FY25 TO FY27 Q1)&quot;&#13;&#10;    THEN [decoupling_gap_pp]&#13;&#10;    END&#13;&#10;)&#13;&#10;-&#13;&#10;AVG(&#13;&#10;    IF [period] = &quot;Period A (FY22 TO FY24)&quot;&#13;&#10;    THEN [decoupling_gap_pp]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Quarter Date' datatype='date' name='[Calculation_0635566004379653]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='MAKEDATE(&#13;&#10;    [fiscal_year],&#13;&#10;    ([quarter_num] - 1) * 3 + 1,&#13;&#10;    1&#13;&#10;)' />
      </column>
      <column caption='Quarter Label' datatype='string' name='[Calculation_0765855259631616]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;FY&quot; + RIGHT(STR([fiscal_year]), 2)&#13;&#10;+ &quot; Q&quot; + STR([quarter_num])' />
      </column>
      <column caption='Quarter Index' datatype='integer' name='[Calculation_0765855260295169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([fiscal_year] - 2022) * 4 + [quarter_num]' />
      </column>
      <column caption='Period Decoupling Change' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_0765855279669254]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [company] :&#13;&#10;    AVG(&#13;&#10;        IF [fiscal_year] &gt;= 2025&#13;&#10;        THEN [decoupling_gap_pp]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}&#13;&#10;-&#13;&#10;{ FIXED [company] :&#13;&#10;    AVG(&#13;&#10;        IF [fiscal_year] &lt;= 2024&#13;&#10;        THEN [decoupling_gap_pp]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='dashboard_dataset' datatype='table' name='[__tableau_internal_object_id__].[dashboard_dataset_DCE4B05986F74440886BF6EF5A7C874D]' role='measure' type='quantitative' />
