    <worksheet name='KPI - TCS Decoupling Improvement'>
      <table>
        <view>
          <datasources>
            <datasource caption='dashboard_dataset' name='federated.174visr170rr5s1g41j7m0wqbp9t' />
          </datasources>
          <datasource-dependencies datasource='federated.174visr170rr5s1g41j7m0wqbp9t'>
            <column caption='TCS Decoupling Improvement' datatype='real' name='[Calculation_0268326979305472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#13;&#10;    IF [company] = &quot;TCS&quot;&#13;&#10;    AND [period] = &quot;Period B (FY25 TO FY27 Q1)&quot;&#13;&#10;    THEN [decoupling_gap_pp]&#13;&#10;    END&#13;&#10;)&#13;&#10;-&#13;&#10;AVG(&#13;&#10;    IF [company] = &quot;TCS&quot;&#13;&#10;    AND [period] = &quot;Period A (FY22 TO FY24)&quot;&#13;&#10;    THEN [decoupling_gap_pp]&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Company' datatype='string' name='[company]' role='dimension' type='nominal' />
            <column caption='Decoupling Gap Pp' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[decoupling_gap_pp]' role='measure' type='quantitative' />
            <column caption='Period' datatype='string' name='[period]' role='dimension' type='nominal' />
